# Copy to .env and fill in. Never commit .env.

# --- Supabase ---------------------------------------------------------------
# Project ref (the xxxx in https://xxxx.supabase.co) and database password.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Optional: a full Postgres URL instead of ref + password.
# SUPABASE_DB_URL=

# --- Edge-function secrets (set with `npx supabase secrets set ...`) --------
# Shared secret between pg_cron and the `ingest` function. Any long random string.
SPOKE_CRON_SECRET=
# Model for the `ask` function. Anthropic is used if set, else OpenAI, else a
# fixed template answer (the app still works with no key).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# SPOKE_MODEL=
# Sodabase MCP access token (Sodabase > Settings > MCP > Access tokens).
# Without it the trust gate uses Spoke's own pipeline checks only.
SODABASE_TOKEN=
# SODABASE_DATASET=public.station_status
